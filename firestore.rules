rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Real-time family chat messages across all devices
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create, update: if (request.resource.data.sender is string || request.resource.data.senderName is string);
      allow delete: if true;
    }

    // Full family state sync across devices (routines, tasks, notes, fines, bonuses)
    match /family_sync/{roomId} {
      allow read, write: if true;
    }
  }
}
