{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time chat message sent between family members",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the message"
        },
        "sender": {
          "type": "string",
          "description": "Name of sender (Mamá, Papá, Regina, Romina, Nan)"
        },
        "senderRole": {
          "type": "string",
          "description": "Role of the sender"
        },
        "text": {
          "type": "string",
          "maxLength": 5000,
          "description": "Text content of the chat message"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp of the message"
        },
        "channelId": {
          "type": "string",
          "description": "Channel ID (e.g. family-chat)"
        },
        "isNoticeToMama": {
          "type": "boolean",
          "description": "Flag for important notice sent to Mamá"
        },
        "imageDataUrl": {
          "type": "string",
          "description": "Attached image thumbnail or data"
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji reactions and counts"
        },
        "replyTo": {
          "type": "object",
          "description": "Quoted parent message details"
        },
        "reviewedByMama": {
          "type": "boolean",
          "description": "Whether notice has been reviewed by Mamá"
        },
        "mamaComment": {
          "type": "string",
          "description": "Mamá's comment on the notice"
        },
        "mamaApprovedAt": {
          "type": "string",
          "description": "Approval timestamp by Mamá"
        }
      },
      "required": ["id", "sender", "senderRole", "timestamp"]
    },
    "FamilySyncRoom": {
      "title": "FamilySyncRoom",
      "description": "Full family state synchronization room",
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string",
          "description": "ISO timestamp of last sync update"
        },
        "updatedBy": {
          "type": "string",
          "description": "User who submitted the update"
        },
        "completions": {
          "type": "object",
          "description": "Map of routine completion keys"
        }
      },
      "required": ["lastUpdated"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time chat messages synchronized across all family devices"
    },
    "/family_sync/{roomId}": {
      "schema": "FamilySyncRoom",
      "description": "Real-time full family state synchronization across all devices"
    }
  }
}
